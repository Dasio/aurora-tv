@@ -2176,6 +2176,10 @@ static SDL_Scancode SDL2ScancodeToSDL3Scancode(SDL2_Scancode scancode)
     case SDL2_SCANCODE_MEDIASELECT:
         return SDL_SCANCODE_MEDIA_SELECT;
     default:
+        /* webOS SDL3 remote scancodes. Stock sdl2-compat turns these into UNKNOWN. */
